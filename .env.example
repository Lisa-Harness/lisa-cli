# Lisa Harness environment configuration
#
# Copy this file to ~/.lisa/.env (or the base directory selected by
# LISA_DATA_DIR). The CLI exports these values before framework settings
# are resolved. Values here are placeholders or production defaults; keys
# are commented out unless a setting is safe and useful to activate.

# ── Data location and profiles ───────────────────────────────────────

# Override the base data directory. Defaults to ~/.lisa.
# LISA_DATA_DIR=~/.lisa

# Override the shared packs virtual environment. Defaults to
# <base-data-dir>/venv.
# LISA_PACKS_VENV=

# Named profile: resolves to <profiles-root>/<name>. LISA_DATA_DIR wins
# when both are set. Do not set LISA_PROFILE in a base-directory .env:
# that would apply the profile to every process loading the file. Prefer
# the shell or --profile for per-process/per-command selection.
# LISA_PROFILE=

# Profiles root: defaults to <base-data-dir>/profiles.
# LISA_PROFILES_DIR=
# Windows: LISA_PROFILES_DIR=%OneDrive%/Lisa.Profiles

# Override the session-context Markdown file. When set, the file must exist.
# LISA_SESSION_CONTEXT_PATH=./path/to/session_context.md

# ── Runtime and prompt settings ──────────────────────────────────────

# Host behavior and logging.
# LISA_TIMEZONE=UTC
# LISA_LOG_LEVEL=info
# LISA_LOG_DEBUG=
# LISA_CONVERSATION_ID=

# Thread storage and read-time redaction.
# LISA_THREAD_DIR=
# LISA_THREAD_SEGMENT_TURNS=256
# LISA_THREAD_REDACTION_ENABLED=true
# LISA_THREAD_REDACTION_PATTERNS=

# Provider endpoint overrides for pack-contributed or legacy providers.
# Comma- or newline-separated provider=url pairs. This is usually only
# needed for gateways or proxy deployments.
# LISA_PROVIDER_BASE_URLS=openai=https://api.example.com/v1

# Prompt-cache controls for supported providers.
# LISA_PROMPT_CACHE_ENABLED=true

# Prompt editor key layout and hint overrides.
# Truthy LISA_PROMPT_KEYS=1 selects chat-box keys (Enter sends).
# LISA_PROMPT_KEYS=
# LISA_PROMPT_PS1=
# LISA_PROMPT_HINT_SEND=
# LISA_PROMPT_HINT_NEWLINE=
# LISA_PROMPT_HINT_ABORT=
# LISA_PROMPT_HINT_BANNER=

# Slice housekeeping flags. Each unset value keeps the runtime default.
# LISA_SLICE_PRE_TURN=
# LISA_SLICE_POST_TURN=
# LISA_SLICE_EXPLICIT=
# LISA_SLICE_BUDGET_MS=2000

# Prompt-context lane budgets. Zero rehydration bytes means no independent
# rehydration ceiling; the whole-request allocator remains authoritative.
# LISA_CONTEXT_BUDGET_ENABLED=true
# LISA_CONTEXT_BUDGET_CORE_MAX_TOKENS=2000
# LISA_CONTEXT_BUDGET_MEMORY_MAX_TOKENS=1200
# LISA_CONTEXT_BUDGET_REFLECTION_MAX_TOKENS=1000
# LISA_CONTEXT_BUDGET_HISTORY_MAX_TOKENS=1500
# LISA_CONTEXT_BUDGET_OPERATIONAL_MAX_TOKENS=800
# LISA_CONTEXT_BUDGET_REHYDRATE_MAX_BYTES=0

# ── Turn runner tuning ───────────────────────────────────────────────

# Kernel tunables accept bare names and LISA_-prefixed aliases.
# The bare name wins if both are set. These are the code defaults.

# Shared turn and workflow budgets.
MAX_TOOL_ITERATIONS=300
PER_STEP_MAX_ITERATIONS=75
PER_STEP_MAX_TOOL_CALLS=150
MAX_HANDOFFS_PER_TURN=50

# Fork and delegate sub-turn budgets.
FORK_CHILD_MAX_TOOL_ITERATIONS=50
DELEGATE_CHILD_MAX_TOOL_ITERATIONS=50
DELEGATE_MAX_DEPTH=4
DELEGATION_GRACE_SECONDS=30
FORK_CHILD_MIN_TOOL_CALLS=75
FORK_CHILD_MIN_TOTAL_TOKENS=300000

# Completion and streaming.
TURN_COMPLETION_MAX_TOKENS=16384
STREAM_IDLE_TIMEOUT_S=300

# Loop guards and lifecycle nudges.
FORCED_ACTION_NON_COMPLIANT_CAP=2
STAGE_NUDGE_THRESHOLD=7
STAGE_NUDGE_CAP=10
WRITE_DEADLINE_MARGIN=1
WRITE_RESCUE_MODE=explainer
BUDGET_NUDGE_REMAINING_CALLS=3
DUPLICATE_HINT_LIMIT=2
HINT_CYCLE_MIN_LEN=3
HINT_OVERRIDE_LIMIT=5
MAX_IDENTICAL_TOOL_BATCH_REPEATS=3
MAX_DEREFERENCE_CALLS_PER_TURN=20
MAX_DEREFERENCE_REPEATS_PER_TURN=6
WORKFLOW_PLAN_IDLE_TURN_LIMIT=2

# Prompt and effect-receipt behavior.
BUDGET_BRIEFING_ENABLED=true
CHAT_MODE_DENSE_CONTENT_MIN_CHARS=1000

# Mid-turn context compaction.
INTRA_TURN_COMPACTION_ENABLED=true
INTRA_TURN_SOFT_TRIGGER_SHARE=0.5
INTRA_TURN_HARD_CEILING_SHARE=0.85
INTRA_TURN_ENVELOPE_WINDOW_SHARE=0.8
INTRA_TURN_SPILL_PREVIEW_REPEAT_LIMIT=3
INTRA_TURN_CACHE_READ_SHARE=0.1
INTRA_TURN_CACHE_WRITE_SHARE=1.25
HISTORY_EPOCH_MIN_TOKENS=12000

# Request and context-window sizing.
CONTEXT_DEFAULT_WINDOW_TOKENS=131072
CONTEXT_REQUEST_MARGIN_SHARE=0.05
CONTEXT_REDUCTION_TARGET_SHARE=0.75
CONTEXT_BUDGET_TOKEN_CHAR_RATIO=4

# Advanced context-mapper JSON overrides. Both objects are optional and
# must contain exactly the keys validated by kernel.config.Settings.
# CONTEXT_MAPPER_PROVENANCE_AUTHORITY={"authoritative":1.0,"system_observed":0.98,"user_asserted":0.75,"recalled_memory":0.70,"inferred":0.55,"diagnostic":0.45,"speculative":0.30}
# CONTEXT_MAPPER_CONFLICT_PENALTY={"low":0.0,"medium":0.5,"high":1.0}

# Declarative operations and extra local content roots.
# DECLARATIVE_COMPLETION_MAX_TOKENS=1500
# DECLARATIVE_COMPLETION_TEMPERATURE=0.2
# SDK_CONTENT_ROOTS=

# Memory-pack learning distillation is session-pack configuration, not an
# environment setting. Set memory_distill_max_tokens under
# resources.packs.configuration.lisa-pack-memory; code fallback: 16384.

# ── Provider credentials and endpoints ───────────────────────────────

# Ollama
# LISA_OLLAMA_HOST=http://127.0.0.1:11434
# LISA_OLLAMA_API_KEY=

# OpenRouter
# LISA_OPENROUTER_API_KEY=sk-or-...
# LISA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LISA_OPENROUTER_REFERER=https://github.com/Lisa-Harness/lisa-cli
LISA_OPENROUTER_TITLE="Lisa-Harness/lisa-cli"

# AWS Bedrock. Standard boto3 credentials may be used instead; set explicit
# credentials only when you do not rely on the boto3 credential chain.
# LISA_AWS_ACCESS_KEY_ID=
# LISA_AWS_SECRET_ACCESS_KEY=
# LISA_AWS_SESSION_TOKEN=
# LISA_AWS_REGION=us-east-1

# OpenAI
# LISA_OPENAI_API_KEY=
# LISA_OPENAI_BASE_URL=https://api.openai.com/v1/

# Anthropic
# LISA_ANTHROPIC_API_KEY=
# LISA_ANTHROPIC_BASE_URL=https://api.anthropic.com
# LISA_ANTHROPIC_VERSION=2023-06-01

# Azure OpenAI / AI Foundry
# LISA_AZURE_OPENAI_API_VERSION=2024-10-21
# LISA_AZURE_OPENAI_API_KEY=
# LISA_AZURE_OPENAI_ENDPOINT=https://your-project.services.ai.azure.com/

# Google Gemini
# LISA_GOOGLE_API_KEY=
# LISA_GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com

# ── Web-search provider packs ────────────────────────────────────────

# The corresponding pack must be installed and selected by the session.
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
# BRAVE_SEARCH_API_KEY=

SERPER_SEARCH_ENDPOINT=https://google.serper.dev/search
# SERPER_SEARCH_API_KEY=

TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
# TAVILY_SEARCH_API_KEY=
