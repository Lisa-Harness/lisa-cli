# Lisa — environment configuration for the CLI host.
# Copy to .env; loaded at launch from CWD and/or the data dir (repo-mode
# and tool-install sessions both pick it up). Covers provider credentials
# (LISA_* names; the provider code also accepts the bare AZURE_OPENAI_* /
# OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_API_KEY / OLLAMA_HOST /
# OPENROUTER_API_KEY / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_REGION / AWS_DEFAULT_REGION as fallbacks), data-dir / profile /
# session-context selection, and kernel turn-runner tuning knobs.

# OpenRouter (OpenAI-compatible gateway to many models; set to enable the
# ``openrouter`` provider for ``lisa models discover`` and turns).
# LISA_OPENROUTER_API_KEY=sk-or-...
# Optional base-url override (default shown):
# LISA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AWS Bedrock (uses the standard boto3 credential chain when these are
# unset; set all three to configure credentials explicitly).
# LISA_AWS_ACCESS_KEY_ID=
# LISA_AWS_SECRET_ACCESS_KEY=
# LISA_AWS_REGION=us-east-1

# Data directory override: set to keep state/threads/models in a specific
# directory (defaults to ~/.lisa when unset).
LISA_DATA_DIR=./artifacts

# Named data-dir profile: resolves the data dir to ~/.lisa/profiles/<name>
# (shares the base packs venv; isolates threads/memory/models/policy).
# LISA_DATA_DIR above wins when both are set. Do NOT set LISA_PROFILE in
# a .env: a .env value applies to every process that loads this file, so
# a base-dir .env would pull ALL lisa invocations into the profile.
# Set it in the shell instead (export LISA_PROFILE=ansible) or per
# invocation (`lisa --profile ansible`).
# LISA_PROFILE=

# Path to the session context file (a Markdown session plan). When unset, the
# host uses <data-dir>/config/session_context.md when authored, else the
# bundled core session. When set, the file MUST already exist — a missing
# path is a hard startup error, never a fallback to the default.
# LISA_SESSION_CONTEXT_PATH=./path/to/session_context.md

# ── Turn-runner tuning knobs ──────────────────────────────────────────
# These env vars map to kernel-owned Settings in kernel/config.py and are
# read by the turn runner (kernel/turn_runner/ with the guards in
# kernel/turn_phases/_lifecycle.py). The kernel honors both the bare
# names below and LISA_-prefixed aliases (e.g. LISA_STAGE_NUDGE_CAP).
# The values shown are the code defaults — production-grade; lower them
# only for sandboxed test runs. 0 disables a guard only where noted;
# elsewhere it is a literal value.

# Maximum model-completion iterations per turn. Shared across all mode
# handoffs within a turn (the counter is not reset on transition).
# Code default: 300.
MAX_TOOL_ITERATIONS=300

# Per-child iteration cap for fork fan-out. Fork children run in parallel
# and get a smaller slice than a full sequential turn.
# Code default: 50.
FORK_CHILD_MAX_TOOL_ITERATIONS=50

# Per-child iteration cap for delegate sub-turns. Delegate children run
# sequentially (one at a time, parent waits) and get the same inspect →
# act → verify room as fork children. Code default: 50.
DELEGATE_CHILD_MAX_TOOL_ITERATIONS=50

# Maximum recursion depth for delegate sub-turns. A delegate child may
# itself delegate, forming an agent tree. This cap bounds the tree. The
# root parent turn is depth 0; a direct delegate child is depth 1.
# Code default: 4.
DELEGATE_MAX_DEPTH=4

# Per-step iteration sub-budget. Each workflow step (between two
# transition_stage handoffs) gets its own budget so a chained
# producer→consumer pipeline does not starve its final step on the
# shared MAX_TOOL_ITERATIONS budget. Code default: 75.
PER_STEP_MAX_ITERATIONS=75

# Per-step tool-call sub-budget. Secondary guard against a model that
# burns many tool calls within one step without converging.
# Code default: 150.
PER_STEP_MAX_TOOL_CALLS=150

# Hard backstop against routing-hint loops: caps the total mode handoffs
# per turn and forces a final completion. Code default: 50.
MAX_HANDOFFS_PER_TURN=50

# Consecutive routing-hint overrides (model hands off to a target that
# differs from the hint's suggested target) before the hint layer stops
# injecting further hints for the rest of the turn. Code default: 5.
HINT_OVERRIDE_LIMIT=5

# Forced-action enforcer: when a routing hint encodes a deterministic
# decision (a fork: fan-out, or a single handoff target like plan /
# search / remember) and the model refuses to comply — burning iterations
# on read-only tools or empty completions instead of calling fork /
# transition_stage — the kernel synthesizes the required call itself
# after this many non-compliant dispatches, bounding the pre-handoff
# token burn. Replaces the old FORCED_FORK_NON_FORK_TOOL_CAP /
# FORCED_PLAN_NON_TRANSITION_TOOL_CAP pair (merged into one knob).
# Code default: 2.
FORCED_ACTION_NON_COMPLIANT_CAP=2

# Stuck-stage guard: after this many consecutive iterations in the same
# stage without a transition_stage, the loop injects an advisory nudge
# (a short hint in the lifecycle briefing — never a fake user message).
# Code default: 7.
STAGE_NUDGE_THRESHOLD=7

# After this many consecutive iterations in the same stage without a
# transition, the turn pauses (yields to the operator, resumable with a
# fresh budget) instead of burning tokens; action modes with no yield
# escape finish instead. Must exceed STAGE_NUDGE_THRESHOLD — nudges fire
# between the two. Code default: 10.
STAGE_NUDGE_CAP=10

# Consecutive identical routing hints before duplicate-hint dedup
# suppresses injection. Code default: 2.
DUPLICATE_HINT_LIMIT=2

# Minimum hint-target history length that forms a detectable 2-cycle
# (A, B, A). Code default: 3.
HINT_CYCLE_MIN_LEN=3

# Inject a compact, per-iteration budget status block into the system
# prompt so the model can self-scope its work. Set to false to disable.
# Code default: true.
BUDGET_BRIEFING_ENABLED=true

# Per-iteration completion token budget for turn-loop model calls. Large
# enough for deliberation PLUS an artifact-sized tool-call payload; a
# finish_reason=length truncation is retried once at 2x, context-window
# capped. Code default: 16384.
TURN_COMPLETION_MAX_TOKENS=16384

# Write-nudge lead time, in iterations before the stuck-stage cap. For a
# mode with write obligations, the turn fires one last "land your write"
# nudge this many iterations before the cap would pause the turn. 0
# disables the pre-cap nudge. Code default: 1.
WRITE_DEADLINE_MARGIN=1

# Write-rescue forced-transition target: when a write-contract mode is
# within WRITE_DEADLINE_MARGIN of the stuck-stage cap with no verified
# write, the turn transitions to this terminal capture persona so it
# ends with a written artifact instead of pausing blocked. "" disables
# the rescue transition. Code default: explainer.
WRITE_RESCUE_MODE=explainer

# Minimum response length (characters) for the chat-kind softening in
# the effect-receipt verifier: a chat mode that dispatched at least one
# tool and produced prose at least this long counts as complete without
# a write; shorter "I'll get started" announcement prose blocks as
# no_tools. Code default: 1000.
CHAT_MODE_DENSE_CONTENT_MIN_CHARS=1000

# Memory-pack learning distillation budget — reference only, commented
# out because nothing reads this name from the environment. The
# lisa-pack-memory op reads ``memory_distill_max_tokens`` from the
# session-manifest pack config
# (resources.packs.configuration.lisa-pack-memory); its code fallback is
# 512. See
# sdk/packs/memory/src/sdk/packs/memory/operations/memory/synthesize_learning.py.
# DISTILL_MAX_TOKENS=10000

# Ollama works with no credentials (default http://127.0.0.1:11434);
# set a custom host only if yours lives elsewhere:
# LISA_OLLAMA_HOST=

# Other providers require API keys and sometimes URLs:

# OpenAI (direct). No base-url env override exists (code default
# https://api.openai.com/v1/; the session manifest can override).
LISA_OPENAI_API_KEY=

LISA_ANTHROPIC_API_KEY=
LISA_ANTHROPIC_BASE_URL=https://api.anthropic.com
LISA_ANTHROPIC_VERSION=2023-06-01

LISA_AZURE_OPENAI_API_VERSION=2024-10-21
# Required only when a model routes via the Azure Responses API — there
# is no code default; the client refuses to build without it on that path.
LISA_AZURE_OPENAI_RESPONSES_API_VERSION=2025-03-01-preview
LISA_AZURE_OPENAI_API_KEY=
LISA_AZURE_OPENAI_ENDPOINT=https://your-project.services.ai.azure.com/

LISA_GOOGLE_API_KEY=
# Code default is the bare domain (paths are appended automatically);
# a full .../v1beta3/models URL is also accepted.
LISA_GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com

LISA_OPENROUTER_API_KEY=
LISA_OPENROUTER_REFERER=https://github.com/Lisa-Harness/lisa-cli
LISA_OPENROUTER_TITLE="lisa-harness-cli"

BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_API_KEY=

SERPER_SEARCH_ENDPOINT=https://google.serper.dev/search
SERPER_SEARCH_API_KEY=

TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
TAVILY_SEARCH_API_KEY=
